# Runtime: demo uses in-memory repositories. supabase enables persistent data/auth.
APP_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Edición comercial / marca blanca. Si se dejan vacías, se usa la edición ImpulsIA.
# Estas variables son públicas y se fijan durante el build de Next.js.
NEXT_PUBLIC_BRAND_NAME=ImpulsIA
NEXT_PUBLIC_BRAND_LEGAL_NAME=ImpulsIA
# Opcional: RUT de la razón social (12.345.678-9); se muestra en /privacidad.
NEXT_PUBLIC_BRAND_TAX_ID=
# Opcional: código de verificación de dominio de Meta Business (metaetiqueta facebook-domain-verification).
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
NEXT_PUBLIC_BRAND_TAGLINE=Automatización, integraciones e IA para empresas que quieren avanzar.
NEXT_PUBLIC_BRAND_DESCRIPTION=Automatizamos procesos, integramos sistemas y aplicamos IA con soluciones de alcance claro.
NEXT_PUBLIC_BRAND_CONTACT_EMAIL=contacto@impulsialabs.cl
NEXT_PUBLIC_BRAND_HERO_EYEBROW=Automatización hecha a tu medida
NEXT_PUBLIC_BRAND_HERO_TITLE=Tu empresa avanza.
NEXT_PUBLIC_BRAND_HERO_HIGHLIGHT=El trabajo repetitivo no.
NEXT_PUBLIC_BRAND_HERO_DESCRIPTION=Integramos tus sistemas, automatizamos procesos y aplicamos IA para reducir tiempo, bajar costos y aumentar la rentabilidad de tu pyme — con soluciones a tu alcance.
NEXT_PUBLIC_BRAND_PRIMARY_COLOR=#0f766e
NEXT_PUBLIC_BRAND_PRIMARY_DARK_COLOR=#0b514d
NEXT_PUBLIC_BRAND_ACCENT_COLOR=#b8f74f
NEXT_PUBLIC_BRAND_DARK_SURFACE_COLOR=#102e2f

# Configuración comercial por edición. Los montos se guardan como unidades
# monetarias enteras; el proveedor Flow sólo admite CLP en la implementación actual.
NEXT_PUBLIC_COMMERCE_LOCALE=es-CL
NEXT_PUBLIC_COMMERCE_CURRENCY=CLP
PRICING_VERSION=2026-09-v1
PRICING_EFFECTIVE_FROM=2026-09-01
PRICING_DAY_RATE=200000
PRICING_MINIMUM_IMPLEMENTATION=200000
PRICING_MINIMUM_MAINTENANCE=65000
PRICING_ROUNDING_MULTIPLE=1000
PRICING_COMPLEXITY_FACTORS_JSON={"standard":1,"medium":1.2,"high":1.5,"research":1.75,"advanced_research":2}
PRICING_MAINTENANCE_BRACKETS_JSON=[{"upTo":400000,"ratePercent":20,"floor":65000},{"upTo":1000000,"ratePercent":17.5,"floor":80000},{"upTo":2000000,"ratePercent":15,"floor":175000},{"upTo":4000000,"ratePercent":12,"floor":300000},{"upTo":null,"ratePercent":10,"floor":480000}]
PRICING_EXPANSION_DISCOUNT_TIERS_JSON=[{"fromSolution":1,"discountPercent":0},{"fromSolution":2,"discountPercent":25},{"fromSolution":3,"discountPercent":30},{"fromSolution":4,"discountPercent":35},{"fromSolution":5,"discountPercent":40}]
SOLUTION_CATALOG_JSON=[{"key":"erp-ecommerce","name":"Sincronización ERP + ecommerce","category":"Integraciones","description":"Sincroniza pedidos, stock y estados.","defaultDays":4,"defaultComplexity":"medium"},{"key":"payment-reconciliation","name":"Conciliación automática","category":"Finanzas","description":"Compara pagos, documentos y movimientos.","defaultDays":5,"defaultComplexity":"high"},{"key":"daily-report","name":"Reporte operativo diario","category":"Datos","description":"Consolida y distribuye indicadores.","defaultDays":2,"defaultComplexity":"standard"}]
# Opcionales: vacíos usan la edición ImpulsIA. En las galerías, [] oculta la sección.
LANDING_CONTENT_JSON=
PRODUCT_SHOWCASE_JSON=
CASE_STUDIES_JSON=

# Supabase (required when APP_MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Preferida por Supabase para backend. Nunca usar NEXT_PUBLIC_ ni exponer al browser.
SUPABASE_SECRET_KEY=
# Compatibilidad legacy; usar sólo si el proyecto aún no ofrece Secret Keys.
SUPABASE_SERVICE_ROLE_KEY=

# Secret store: local-memory is development-only. Use a vault/KMS provider in production.
SECRET_STORE_PROVIDER=local-memory

# WhatsApp Business Platform / Cloud API. El botón queda en modo preparación
# mientras NEXT_PUBLIC_WHATSAPP_NUMBER esté vacío. Usa sólo dígitos con código país.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola, quiero evaluar una automatización para mi empresa.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Definir explícitamente una versión vigente soportada por Meta al conectar la cuenta.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_BOT_ENABLED=false
# Instagram: mensajes directos atendidos por el asistente (ver docs/INSTAGRAM_DM.md).
INSTAGRAM_BOT_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_GRAPH_VERSION=v25.0
SECRET_ENCRYPTION_KEY=

# External providers remain disabled until explicitly configured.
PAYMENT_PROVIDER=mock
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
FLOW_API_KEY=
FLOW_SECRET_KEY=
# sandbox hasta validar el flujo end to end; production sólo cuando esté todo listo.
FLOW_ENVIRONMENT=sandbox
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=
# Antispam del formulario de diagnóstico (Cloudflare Turnstile). Opcional; si se usa, van las dos juntas.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Agenda de reuniones del asistente de IA en Google Calendar (opcional; apagada por defecto).
# El refresh token es del buzón dueño del calendario, con los scopes calendar.events y calendar.freebusy.
ASSISTANT_SCHEDULING_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
ASSISTANT_TIME_ZONE=America/Santiago
# Horario y días hábiles (0 = domingo … 6 = sábado), duración, anticipación mínima y horizonte.
ASSISTANT_BUSINESS_HOURS=09:00-18:00
ASSISTANT_BUSINESS_DAYS=1,2,3,4,5
ASSISTANT_MEETING_MINUTES=30
ASSISTANT_MEETING_NOTICE_MINUTES=120
ASSISTANT_MEETING_HORIZON_DAYS=7
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Asistente comercial con IA (WhatsApp). "disabled" usa el guion determinista.
AI_PROVIDER=disabled
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# Topes de gasto y abuso; ver docs/WHATSAPP_GO_LIVE.md.
AI_DAILY_BUDGET_USD=2
AI_MAX_REPLIES_PER_CONVERSATION_DAY=30
AI_MAX_MESSAGES_PER_SENDER_MINUTE=10
AI_MAX_MESSAGES_PER_SENDER_DAY=50
# Notas de voz en WhatsApp (transcripción y respuesta con voz). Sin clave, los audios no se entienden.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
# Opcional: voz de ElevenLabs (biblioteca de voces, acento chileno). Sin estas dos, la voz es de OpenAI.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ASSISTANT_VOICE_REPLIES=true
# Espera antes de responder para agrupar mensajes seguidos del cliente (segundos).
ASSISTANT_BATCH_SECONDS=6
CRON_SECRET=
# Seguimiento automático de conversaciones pausadas de WhatsApp (minutos, máximo 4).
ASSISTANT_FOLLOW_UP_ENABLED=false
ASSISTANT_FOLLOW_UP_MINUTES=4
WEBHOOK_SECRET=
# Reporte de campañas y gastos: pesos chilenos por dólar (gasto de IA y gastos en USD).
MARKETING_USD_CLP_RATE=950
