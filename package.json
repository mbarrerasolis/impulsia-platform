{
  "name": "impulsia-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/select-edition.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:http": "node scripts/http-smoke.mjs",
    "smoke:supabase": "node --env-file=.env.local scripts/supabase-smoke.mjs",
    "test:rls": "node --env-file=.env.local scripts/rls-smoke.mjs",
    "smoke:commercial": "node --env-file=.env.local scripts/commercial-smoke.mjs",
    "smoke:billing": "node --env-file=.env.local scripts/billing-smoke.mjs",
    "smoke:contacts": "node --env-file=.env.local scripts/contacts-smoke.mjs",
    "smoke:manual-payment": "node --env-file=.env.local scripts/manual-payment-smoke.mjs",
    "smoke:tasks": "node --env-file=.env.local scripts/tasks-smoke.mjs",
    "edition:validate": "node scripts/edition-kit.mjs validate",
    "edition:create": "node scripts/edition-kit.mjs create",
    "edition:snapshot": "node scripts/edition-kit.mjs snapshot",
    "edition:activate": "node scripts/edition-kit.mjs activate",
    "provision:prepare": "node scripts/provision-edition.mjs prepare",
    "provision:validate": "node scripts/provision-edition.mjs validate",
    "provision:plan": "node scripts/provision-edition.mjs plan",
    "provision:domain": "node scripts/provision-edition.mjs domain",
    "provision:rehearse": "node scripts/provision-edition.mjs rehearse",
    "provision:apply": "node scripts/provision-edition.mjs apply",
    "provision:verify": "node scripts/provision-edition.mjs verify",
    "admin:invite": "node scripts/invite-admin.mjs",
    "check": "npm run edition:validate && npm run provision:validate -- --slug impulsia && npm run lint && npm run typecheck && npm run test && npm run build",
    "db:start": "supabase start --exclude studio,vector",
    "db:start:full": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vitest": "^5.0.0"
  }
}
